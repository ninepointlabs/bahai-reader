<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.bahai.Reader</id>
  <name>Bahá’í Reader</name>
  <summary>Offline Bahá’í prayers and writings</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <developer id="io.github.ninepointlabs">
    <name>Nine Point Labs</name>
  </developer>
  <description>
    <p>A quiet, native reader for Bahá’í prayers, the Hidden Words and the Writings. Ten English collections are included for offline reading, and other languages can be downloaded.</p>
    <ul>
      <li>Collapsible contents, saved passages and offline search</li>
      <li>Adjustable fonts, text size, spacing and reading palettes</li>
      <li>Follows the active Omarchy theme live, with light, dark and sepia palettes elsewhere</li>
    </ul>
    <p>Texts are supplied by BahaiPrayers.net. This is an independent community app, not an official publication of a Bahá’í institution.</p>
  </description>
  <launchable type="desktop-id">org.bahai.Reader.desktop</launchable>
  <categories>
    <category>Education</category>
    <category>Literature</category>
  </categories>
  <keywords>
    <keyword>Bahai</keyword>
    <keyword>Prayer</keyword>
    <keyword>Writings</keyword>
  </keywords>
  <url type="homepage">https://bahaireader.org/</url>
  <url type="bugtracker">https://github.com/ninepointlabs/bahai-reader/issues</url>
  <url type="vcs-browser">https://github.com/ninepointlabs/bahai-reader</url>
  <provides>
    <binary>bahai-reader</binary>
  </provides>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="0.1.4" date="2026-10-19">
      <description><p>An AppImage that adds itself to your app menu, and a Flatpak bundle for any Linux.</p></description>
    </release>
    <release version="0.1.3" date="2026-10-17">
      <description><p>Adds an About screen.</p></description>
    </release>
    <release version="0.1.2" date="2026-10-14">
      <description><p>Fedora RPM fix and passage citations.</p></description>
    </release>
    <release version="0.1.1" date="2026-09-13"/>
    <release version="0.1.0" date="2026-09-13"/>
  </releases>
</component>
