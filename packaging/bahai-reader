#!/bin/sh
# Installed as /usr/bin/bahai-reader; the Flutter bundle lives in /usr/lib/bahai-reader.
set -eu
if command -v uwsm-app >/dev/null 2>&1 && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    exec uwsm-app -- /usr/lib/bahai-reader/bahai-reader "$@"
fi
exec /usr/lib/bahai-reader/bahai-reader "$@"
